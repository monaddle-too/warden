{
  "metadata": {
    "name": "wc-0123456789abcdef01234567",
    "namespace": "warden-sandboxes",
    "labels": {
      "app.kubernetes.io/managed-by": "warden-runner",
      "warden.monaddle.com/sandbox": "wc-0123456789abcdef01234567"
    },
    "annotations": {
      "warden.monaddle.com/generation": "gen-1",
      "warden.monaddle.com/sandbox-id": "sandbox-one",
      "warden.monaddle.com/workspace": "fresh"
    }
  },
  "spec": {
    "containers": [
      {
        "name": "guest",
        "image": "ghcr.io/monaddle-too/warden-guest-base@sha256:abababababababababababababababababababababababababababababababab",
        "args": [
          "sleep",
          "infinity"
        ],
        "volumeMounts": [
          {
            "name": "home",
            "mountPath": "/home/agent"
          },
          {
            "name": "trust",
            "mountPath": "/opt/warden/trust",
            "readOnly": true
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ],
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "1024Mi"
          },
          "requests": {
            "cpu": "1",
            "memory": "1024Mi"
          }
        },
        "securityContext": {
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "home",
        "persistentVolumeClaim": {
          "claimName": "wc-0123456789abcdef01234567"
        }
      },
      {
        "name": "trust",
        "configMap": {
          "name": "warden-guest-trust"
        }
      },
      {
        "name": "tmp",
        "emptyDir": {}
      }
    ],
    "runtimeClassName": "gvisor",
    "securityContext": {
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "fsGroup": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "warden.monaddle.com/pool": "sandboxes"
    },
    "tolerations": [
      {
        "key": "sandbox.gke.io/runtime",
        "operator": "Equal",
        "value": "gvisor",
        "effect": "NoSchedule"
      }
    ],
    "restartPolicy": "Always",
    "terminationGracePeriodSeconds": 10,
    "enableServiceLinks": false
  },
  "status": {}
}
