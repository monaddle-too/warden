# Settings of the GKE Autopilot test cluster (docs/warden-kubernetes.md,
# "A real cluster: GKE Autopilot with public previews"). Copy this file to
# deploy/k8s/gke/env, which is git-ignored because it names your project,
# domain and account; scripts/k8s-gke.sh reads it.

# The Google Cloud project (billing enabled). gcloud must be signed in to an
# account that owns it.
WARDEN_GKE_PROJECT=my-project
# Autopilot clusters are regional; us-central1 is the cheapest region.
WARDEN_GKE_REGION=us-central1
WARDEN_GKE_CLUSTER=warden

# The zone delegated to Cloud DNS: the app is https://<domain>/ and previews
# are https://<binding-id>.<domain>/ (auth.publicURL and previews.hostSuffix
# in the chart). One delegation, two records, one wildcard certificate.
WARDEN_GKE_DOMAIN=warden.example.com

# The Google account that may open Warden (auth.google.owners) and the
# Let's Encrypt contact.
WARDEN_GKE_OWNER=you@example.com

# The Google sign-in web client (auth.google.signInClientID): an OAuth
# client ID of type "Web application" in the project's APIs & Services →
# Credentials, with https://<domain> as an authorized JavaScript origin.
WARDEN_GKE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# Let's Encrypt environment: "staging" issues untrusted certificates without
# rate limits (the browser warns; the flow still works), "production" the
# real ones. Start with staging until the DNS delegation is proven.
WARDEN_GKE_ACME=staging
