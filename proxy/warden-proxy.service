[Unit]
Description=Warden transparent enforcement proxy
Requires=warden-firewall.service
After=warden-firewall.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/warden/venv/bin/mitmdump --quiet --mode transparent --listen-host 0.0.0.0 --listen-port 8080 --set confdir=/var/lib/warden/mitmproxy --set connection_strategy=lazy --set upstream_cert=false --set ssl_insecure=false --set rawtcp=false --set websocket=false --set body_size_limit=128m --set flow_detail=0 -s /opt/warden/proxy/addon.py
Restart=always
RestartSec=2
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/warden
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_VSOCK AF_NETLINK

[Install]
WantedBy=multi-user.target
